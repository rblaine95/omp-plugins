{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "objectWrap": "preserve",
  "sortImports": true,
  "ignorePatterns": [".claude", ".omp", ".zed/settings.json", "**/*.md", "**/package.json"]
}
